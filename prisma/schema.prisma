generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─── ORGANIZATION & MULTI-TENANCY ────────────────────────────────────────────

model Organization {
  id                   String    @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  name                 String    @db.NVarChar(255)
  slug                 String    @unique @db.NVarChar(100)
  subscriptionPlan     String    @default("starter") @map("subscription_plan") @db.NVarChar(50)
  subscriptionStatus   String    @default("trial") @map("subscription_status") @db.NVarChar(50)
  trialEndsAt          DateTime? @map("trial_ends_at")
  stripeCustomerId     String?   @unique @map("stripe_customer_id") @db.NVarChar(255)
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id") @db.NVarChar(255)
  billingEmail         String?   @map("billing_email") @db.NVarChar(255)
  billingMetadata      Json?     @map("billing_metadata")
  suspendedAt          DateTime? @map("suspended_at")
  suspensionReason     String?   @map("suspension_reason") @db.NVarChar(Max)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  hotels               Hotel[]
  userProfiles         UserProfile[]
  loyaltyProgram       LoyaltyProgram?
  loyaltyMembers       LoyaltyMember[]
  subscriptionEvents   SubscriptionEvent[]
  billingSubscription  BillingSubscription?
  billingInvoices      BillingInvoice[]
  billingCredits       BillingCredit[]
  platformAddons       PlatformAddon[]
  platformAuditLogs    PlatformAuditLog[]

  @@map("organizations")
}

model Hotel {
  id               String   @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  organizationId   String   @map("organization_id") @db.UniqueIdentifier
  name             String   @db.NVarChar(255)
  slug             String   @unique @db.NVarChar(100)
  type             String?  @db.NVarChar(50)
  address          String?  @db.NVarChar(Max)
  city             String?  @db.NVarChar(100)
  country          String   @default("Thailand") @db.NVarChar(100)
  timezone         String   @default("Asia/Bangkok") @db.NVarChar(50)
  currency         String   @default("THB") @db.NVarChar(10)
  phone            String?  @db.NVarChar(40)
  email            String?  @db.NVarChar(255)
  website          String?  @db.NVarChar(255)
  checkInTime      String   @default("14:00") @map("check_in_time") @db.NVarChar(10)
  checkOutTime     String   @default("12:00") @map("check_out_time") @db.NVarChar(10)
  taxId            String?  @map("tax_id") @db.NVarChar(20)
  vatRate          Decimal  @default(0.07) @map("vat_rate") @db.Decimal(5, 4)
  logoUrl          String?  @map("logo_url") @db.NVarChar(Max)
  heroImageUrl     String?  @map("hero_image_url") @db.NVarChar(Max)
  tagline          String?  @db.NVarChar(500)
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  starRating       Int      @default(3) @map("star_rating")
  totalRooms       Int      @default(0) @map("total_rooms")
  description      String?  @db.NVarChar(Max)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization              Organization               @relation(fields: [organizationId], references: [id])
  roomTypes                 RoomType[]
  rooms                     Room[]
  ratePlans                 RatePlan[]
  rateCalendars             RateCalendar[]
  guests                    Guest[]
  reservations              Reservation[]
  folios                    Folio[]
  housekeepingTasks         HousekeepingTask[]
  maintenanceRequests       MaintenanceRequest[]
  workOrders                WorkOrder[]
  conversations             Conversation[]
  messageTemplates          MessageTemplate[]
  channelConnections        ChannelConnection[]
  payments                  Payment[]
  invoices                  Invoice[]
  tm30Reports               Tm30Report[]
  taxFilings                TaxFiling[]
  accountingSyncLogs        AccountingSyncLog[]
  otaReconciliations        OtaReconciliation[]
  fbOutlets                 FbOutlet[]
  fbOrders                  FbOrder[]
  spaServices               SpaService[]
  spaTherapists             SpaTherapist[]
  spaBookings               SpaBooking[]
  eventSpaces               EventSpace[]
  events                    Event[]
  loyaltyTiers              LoyaltyTier[]
  loyaltyTransactions       LoyaltyTransaction[]
  marketingCampaigns        MarketingCampaign[]
  reviews                   Review[]
  bookingReviews            BookingReview[]
  aiLogs                    AiLog[]
  aiEvaluations             AiEvaluation[]
  knowledgeBases            KnowledgeBase[]
  auditLogs                 AuditLog[]
  hotelGallery              HotelGallery[]
  groupBookings             GroupBooking[]
  mobileKeys                MobileKey[]
  iotDevices                IotDevice[]
  distributionChannels      DistributionChannel[]
  revenueTargets            RevenueTarget[]
  operationalEvents         OperationalEvent[]
  automationRules           AutomationRule[]
  automationRuns            AutomationRun[]
  aiConciergeKnowledge      AiConciergeKnowledge[]
  aiConciergeLogs           AiConciergeLog[]
  localizationSettings      HotelLocalizationSettings?
  otaConnections            OtaConnection[]
  otaSyncLogs               OtaSyncLog[]
  goLiveChecks              GoLiveCheck[]
  platformAuditLogs         PlatformAuditLog[]
  approvals                 Approval[]
  departmentSlaRules        DepartmentSlaRule[]
  guestRequestRoutes        GuestRequestRoute[]
  roomStatusEvents          RoomStatusEvent[]
  workflowTemplates         WorkflowTemplate[]
  shifts                    Shift[]
  shiftHandovers            ShiftHandover[]
  staffNotifications        StaffNotification[]
  crmSegmentDefinitions     CrmSegmentDefinition[]
  conversationRoutingRules  ConversationRoutingRule[]
  operationalIncidents      OperationalIncident[]
  emailLogs                 EmailLog[]
  promoCodes                PromoCode[]
  webhookEvents             WebhookEvent[]
  reviewRequests            ReviewRequest[]
  userAdditionalRoles       UserAdditionalRole[]

  @@index([organizationId])
  @@map("hotels")
}

model UserProfile {
  id                  String    @id @db.UniqueIdentifier
  organizationId      String?   @map("organization_id") @db.UniqueIdentifier
  email               String    @db.NVarChar(255)
  fullName            String?   @map("full_name") @db.NVarChar(255)
  role                String    @default("staff") @db.NVarChar(50)
  language            String    @default("th") @db.NVarChar(10)
  phone               String?   @db.NVarChar(40)
  active              Boolean   @default(true)
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  organization        Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("user_profiles")
}

// ─── ROOM MANAGEMENT ─────────────────────────────────────────────────────────

model RoomType {
  id            String   @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId       String   @map("hotel_id") @db.UniqueIdentifier
  name          String   @db.NVarChar(160)
  code          String?  @db.NVarChar(20)
  description   String?  @db.NVarChar(Max)
  maxOccupancy  Int      @default(2) @map("max_occupancy")
  baseRate      Decimal  @map("base_rate") @db.Decimal(12, 2)
  amenities     Json     @default("[]")
  sizeSqm       Int?     @map("size_sqm")
  bedType       String?  @map("bed_type") @db.NVarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")

  hotel              Hotel               @relation(fields: [hotelId], references: [id])
  rooms              Room[]
  ratePlans          RatePlan[]
  rateCalendars      RateCalendar[]
  reservations       Reservation[]
  channelRoomMappings ChannelRoomMapping[]
  roomTypeImages     RoomTypeImage[]
  guestWishlists     GuestWishlist[]

  @@index([hotelId])
  @@map("room_types")
}

model Room {
  id           String   @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId      String   @map("hotel_id") @db.UniqueIdentifier
  roomTypeId   String?  @map("room_type_id") @db.UniqueIdentifier
  roomNumber   String   @map("room_number") @db.NVarChar(20)
  floor        Int?
  status       String   @default("available") @db.NVarChar(20)
  notes        String?  @db.NVarChar(Max)
  createdAt    DateTime @default(now()) @map("created_at")

  hotel               Hotel                @relation(fields: [hotelId], references: [id])
  roomType            RoomType?            @relation(fields: [roomTypeId], references: [id])
  reservations        Reservation[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
  mobileKeys          MobileKey[]
  iotDevices          IotDevice[]
  roomStatusEvents    RoomStatusEvent[]
  operationalIncidents OperationalIncident[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId])
  @@index([roomTypeId])
  @@map("rooms")
}

model RatePlan {
  id                  String   @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId             String   @map("hotel_id") @db.UniqueIdentifier
  roomTypeId          String?  @map("room_type_id") @db.UniqueIdentifier
  name                String   @db.NVarChar(160)
  rateModifier        Decimal  @default(1.0) @map("rate_modifier") @db.Decimal(8, 4)
  includesBreakfast   Boolean  @default(false) @map("includes_breakfast")
  cancellationPolicy  String?  @map("cancellation_policy") @db.NVarChar(Max)
  active              Boolean  @default(true)

  hotel               Hotel               @relation(fields: [hotelId], references: [id])
  roomType            RoomType?           @relation(fields: [roomTypeId], references: [id])
  rateCalendars       RateCalendar[]
  reservations        Reservation[]
  channelRoomMappings ChannelRoomMapping[]

  @@index([hotelId])
  @@map("rate_plans")
}

model RateCalendar {
  id                  String   @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId             String   @map("hotel_id") @db.UniqueIdentifier
  roomTypeId          String   @map("room_type_id") @db.UniqueIdentifier
  ratePlanId          String   @map("rate_plan_id") @db.UniqueIdentifier
  date                DateTime @db.Date
  rate                Decimal  @db.Decimal(12, 2)
  availableCount      Int?     @map("available_count")
  minStay             Int      @default(1) @map("min_stay")
  maxStay             Int?     @map("max_stay")
  closedToArrival     Boolean  @default(false) @map("closed_to_arrival")
  closedToDeparture   Boolean  @default(false) @map("closed_to_departure")

  hotel      Hotel    @relation(fields: [hotelId], references: [id])
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id])

  @@unique([hotelId, roomTypeId, ratePlanId, date])
  @@index([hotelId, date])
  @@map("rate_calendar")
}

// ─── GUESTS ───────────────────────────────────────────────────────────────────

model Guest {
  id                String   @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId           String   @map("hotel_id") @db.UniqueIdentifier
  firstName         String   @map("first_name") @db.NVarChar(100)
  lastName          String?  @map("last_name") @db.NVarChar(100)
  email             String?  @db.NVarChar(255)
  phone             String?  @db.NVarChar(40)
  nationality       String?  @db.NVarChar(60)
  passportNumber    String?  @map("passport_number") @db.NVarChar(60)
  idCardNumber      String?  @map("id_card_number") @db.NVarChar(60)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  preferredLanguage String   @default("th") @map("preferred_language") @db.NVarChar(10)
  preferences       Json     @default("{}")
  vipStatus         Boolean  @default(false) @map("vip_status")
  loyaltyPoints     Int      @default(0) @map("loyalty_points")
  loyaltyTier       String   @default("bronze") @map("loyalty_tier") @db.NVarChar(30)
  notes             String?  @db.NVarChar(Max)
  marketingConsent  Boolean  @default(false) @map("marketing_consent")
  totalStays        Int      @default(0) @map("total_stays")
  totalRevenue      Decimal  @default(0) @map("total_revenue") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  hotel                Hotel                @relation(fields: [hotelId], references: [id])
  reservations         Reservation[]
  conversations        Conversation[]
  invoices             Invoice[]
  tm30Reports          Tm30Report[]
  loyaltyTransactions  LoyaltyTransaction[]
  reviews              Review[]
  spaBookings          SpaBooking[]
  emailLogs            EmailLog[]
  reviewRequests       ReviewRequest[]
  crmSegmentMembers    CrmSegmentMember[]

  @@index([hotelId])
  @@index([email])
  @@map("guests")
}

model GuestAccount {
  id                String    @id @db.UniqueIdentifier
  email             String    @db.NVarChar(255)
  firstName         String    @map("first_name") @db.NVarChar(100)
  lastName          String?   @map("last_name") @db.NVarChar(100)
  phone             String?   @db.NVarChar(40)
  nationality       String?   @db.NVarChar(60)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  passportNumber    String?   @map("passport_number") @db.NVarChar(60)
  preferredLanguage String    @default("th") @map("preferred_language") @db.NVarChar(10)
  avatarUrl         String?   @map("avatar_url") @db.NVarChar(Max)
  marketingConsent  Boolean   @default(false) @map("marketing_consent")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  reservations   Reservation[]
  bookingReviews BookingReview[]
  mobileKeys     MobileKey[]
  guestWishlists GuestWishlist[]
  privacyRequests PrivacyRequest[]
  loyaltyMembers LoyaltyMember[]

  @@index([email])
  @@map("guest_accounts")
}

// ─── RESERVATIONS ─────────────────────────────────────────────────────────────

model Reservation {
  id                  String    @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId             String    @map("hotel_id") @db.UniqueIdentifier
  guestId             String?   @map("guest_id") @db.UniqueIdentifier
  roomId              String?   @map("room_id") @db.UniqueIdentifier
  roomTypeId          String    @map("room_type_id") @db.UniqueIdentifier
  ratePlanId          String?   @map("rate_plan_id") @db.UniqueIdentifier
  guestAccountId      String?   @map("guest_account_id") @db.UniqueIdentifier
  groupBookingId      String?   @map("group_booking_id") @db.UniqueIdentifier
  reservationCode     String    @unique @map("reservation_code") @db.NVarChar(20)
  checkIn             DateTime  @map("check_in") @db.Date
  checkOut            DateTime  @map("check_out") @db.Date
  numAdults           Int       @default(1) @map("num_adults")
  numChildren         Int       @default(0) @map("num_children")
  status              String    @default("confirmed") @db.NVarChar(30)
  source              String    @default("direct") @db.NVarChar(40)
  externalId          String?   @map("external_id") @db.NVarChar(100)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(12, 2)
  paidAmount          Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  depositAmount       Decimal   @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  cancellationPolicy  Json?     @map("cancellation_policy")
  paymentMethod       String    @default("online") @map("payment_method") @db.NVarChar(30)
  paymentStatus       String    @default("pending") @map("payment_status") @db.NVarChar(20)
  specialRequests     String?   @map("special_requests") @db.NVarChar(Max)
  internalNotes       String?   @map("internal_notes") @db.NVarChar(Max)
  estimatedArrival    String?   @map("estimated_arrival") @db.NVarChar(10)
  roomPreference      String?   @map("room_preference") @db.NVarChar(255)
  preferredLanguage   String?   @map("preferred_language") @db.NVarChar(10)
  isGroupMaster       Boolean   @default(false) @map("is_group_master")
  tm30Reported        Boolean   @default(false) @map("tm30_reported")
  tm30ReportedAt      DateTime? @map("tm30_reported_at")
  idempotencyKey      String?   @map("idempotency_key") @db.NVarChar(128)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancellationReason  String?   @map("cancellation_reason") @db.NVarChar(Max)

  hotel               Hotel                @relation(fields: [hotelId], references: [id])
  guest               Guest?               @relation(fields: [guestId], references: [id])
  room                Room?                @relation(fields: [roomId], references: [id])
  roomType            RoomType             @relation(fields: [roomTypeId], references: [id])
  ratePlan            RatePlan?            @relation(fields: [ratePlanId], references: [id])
  guestAccount        GuestAccount?        @relation(fields: [guestAccountId], references: [id])
  groupBooking        GroupBooking?        @relation(fields: [groupBookingId], references: [id])
  folios              Folio[]
  payments            Payment[]
  invoices            Invoice[]
  tm30Reports         Tm30Report[]
  conversations       Conversation[]
  reviews             Review[]
  spaBookings         SpaBooking[]
  fbOrders            FbOrder[]
  loyaltyTransactions LoyaltyTransaction[]
  otaReconciliations  OtaReconciliation[]
  mobileKeys          MobileKey[]
  bookingReviews      BookingReview[]
  emailLogs           EmailLog[]
  reviewRequests      ReviewRequest[]
  roomStatusEvents    RoomStatusEvent[]
  automationRuns      AutomationRun[]
  aiConciergeLogs     AiConciergeLog[]

  @@index([hotelId])
  @@index([guestId])
  @@index([checkIn, checkOut])
  @@index([status])
  @@map("reservations")
}

model ReservationIdempotencyKey {
  id             String   @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId        String   @map("hotel_id") @db.UniqueIdentifier
  idempotencyKey String   @map("idempotency_key") @db.NVarChar(128)
  reservationId  String   @map("reservation_id") @db.UniqueIdentifier
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([hotelId, idempotencyKey])
  @@map("reservation_idempotency_keys")
}

// ─── BILLING / FOLIO ──────────────────────────────────────────────────────────

model Folio {
  id             String    @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  reservationId  String    @map("reservation_id") @db.UniqueIdentifier
  hotelId        String    @map("hotel_id") @db.UniqueIdentifier
  status         String    @default("open") @db.NVarChar(20)
  totalCharges   Decimal   @default(0) @map("total_charges") @db.Decimal(12, 2)
  totalPayments  Decimal   @default(0) @map("total_payments") @db.Decimal(12, 2)
  balance        Decimal   @default(0) @db.Decimal(12, 2)
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  hotel       Hotel       @relation(fields: [hotelId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
  folioItems  FolioItem[]
  payments    Payment[]

  @@index([reservationId])
  @@index([hotelId])
  @@map("folios")
}

model FolioItem {
  id             String   @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  folioId        String   @map("folio_id") @db.UniqueIdentifier
  type           String   @db.NVarChar(50)
  description    String   @db.NVarChar(255)
  amount         Decimal  @db.Decimal(12, 2)
  quantity       Int      @default(1)
  postedBy       String?  @map("posted_by") @db.NVarChar(255)
  postedAt       DateTime @default(now()) @map("posted_at")
  referenceId    String?  @map("reference_id") @db.NVarChar(100)
  referenceType  String?  @map("reference_type") @db.NVarChar(50)

  folio Folio @relation(fields: [folioId], references: [id])

  @@index([folioId])
  @@map("folio_items")
}

// ─── HOUSEKEEPING & MAINTENANCE ───────────────────────────────────────────────

model HousekeepingTask {
  id                   String    @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId              String    @map("hotel_id") @db.UniqueIdentifier
  roomId               String?   @map("room_id") @db.UniqueIdentifier
  assignedTo           String?   @map("assigned_to") @db.UniqueIdentifier
  taskType             String    @map("task_type") @db.NVarChar(50)
  priority             String    @default("normal") @db.NVarChar(20)
  status               String    @default("pending") @db.NVarChar(20)
  notes                String?   @db.NVarChar(Max)
  estimatedDurationMin Int?      @map("estimated_duration_min")
  startedAt            DateTime? @map("started_at")
  completedAt          DateTime? @map("completed_at")
  dueDate              DateTime? @map("due_date")
  createdAt            DateTime  @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id])
  room  Room? @relation(fields: [roomId], references: [id])

  @@index([hotelId])
  @@index([roomId])
  @@map("housekeeping_tasks")
}

model MaintenanceRequest {
  id               String    @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId          String    @map("hotel_id") @db.UniqueIdentifier
  roomId           String?   @map("room_id") @db.UniqueIdentifier
  reportedBy       String?   @map("reported_by") @db.UniqueIdentifier
  assignedTo       String?   @map("assigned_to") @db.UniqueIdentifier
  category         String?   @db.NVarChar(100)
  description      String    @db.NVarChar(Max)
  priority         String    @default("normal") @db.NVarChar(20)
  status           String    @default("open") @db.NVarChar(30)
  resolvedAt       DateTime? @map("resolved_at")
  resolutionNotes  String?   @map("resolution_notes") @db.NVarChar(Max)
  createdAt        DateTime  @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id])
  room  Room? @relation(fields: [roomId], references: [id])

  @@index([hotelId])
  @@map("maintenance_requests")
}

model WorkOrder {
  id          String    @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId     String    @map("hotel_id") @db.UniqueIdentifier
  roomId      String?   @map("room_id") @db.UniqueIdentifier
  assignedTo  String?   @map("assigned_to") @db.UniqueIdentifier
  department  String?   @db.NVarChar(50)
  category    String?   @db.NVarChar(100)
  title       String    @db.NVarChar(255)
  description String?   @db.NVarChar(Max)
  priority    String    @default("normal") @db.NVarChar(20)
  status      String    @default("open") @db.NVarChar(30)
  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  hotel                Hotel                @relation(fields: [hotelId], references: [id])
  room                 Room?                @relation(fields: [roomId], references: [id])
  taskComments         TaskComment[]
  taskAttachments      TaskAttachment[]
  roomStatusEvents     RoomStatusEvent[]
  operationalIncidents OperationalIncident[]

  @@index([hotelId])
  @@map("work_orders")
}

// ─── MESSAGING / CONVERSATIONS ────────────────────────────────────────────────

model Conversation {
  id                  String    @id @default(dbgenerated("NEWID()")) @db.UniqueIdentifier
  hotelId             String    @map("hotel_id") @db.UniqueIdentifier
  guestId             String?   @map("guest_id") @db.UniqueIdentifier
  reservationId       String?   @map("reservation_id") @db.UniqueIdentifier
  channel             String    @db.NVarChar(40)
  channelUserId       String    @map("channel_user_id") @db.NVarChar(255)
  channelThreadId     String?   @map("channel_thread_id") @db.NVarChar(255)
  guestLanguage       String    @default("th") @map("guest_language") @db.NVarChar(10)
  guestName           String?   @map("guest_name") @db.NVarChar(255)
  status              String    @default("open") @db.NVarChar(20)
  assignedTo          String?   @map("assigned_to") @db.UniqueIdentifier
  lastMessageAt       DateTime? @map("last_message_at")
  lastMessagePreview  String?   @map("last_message_preview") @db.NVarChar(500)
  unreadCount         Int       @default(0) @map("unread_count")
  aiHandling          Boolean   @default(false) @map("ai_handling")
  needsHuman          Boolean   @default(false) @map("needs_human")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  guest         Guest?        @relation(fields: [guestId], references: [id])
